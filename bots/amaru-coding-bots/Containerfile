# The coding bot for orpiske/amaru-coding-bots itself: orp-bot picks issues
# labelled `needs-implementation` (usually "add a bot for <project>"), writes
# the new bots/<name>/ folder with Codex, runs `make check`, pushes to its
# fork orp-bot/amaru-coding-bots and opens a pull request. CI then builds the
# new image for amd64 and arm64 on that pull request.
#
# The image needs no compiler: the bot writes Containerfiles and YAML, and
# reads the target project (cloned with git or gh) to find its toolchain. It
# has yq and ShellCheck for `make check`. It has no container runtime, so it cannot build
# the images it writes; CI does that.
#
# Build it from the repository root, with this folder as the context:
#   make build BOT=amaru-coding-bots
# or pull quay.io/orpiske/amaru-light-amaru-coding-bots:latest.
#
# Run it with the bot's token and one home volume:
#   export GH_TOKEN=<orp-bot token>
#   podman run -d --name amaru-light-amaru-coding-bots -e GH_TOKEN \
#     -p 127.0.0.1:8768:8765 \
#     -v amaru-light-amaru-coding-bots:/home/mini-amaru:U \
#     localhost/amaru-light-amaru-coding-bots:dev
#
# Then, on the web interface's Agents page, install Codex (and any other
# agent CLI you want) and sign it in. The image does not ship the CLIs; they
# go to ~/.local on the home volume.

ARG BASE_IMAGE=ghcr.io/amaru-oss/amaru-light:latest


FROM ${BASE_IMAGE}

USER root
# make and yq run `make check`; ShellCheck lints the
# scripts. bubblewrap is Codex's sandbox, which it wants installed even when
# bypassed.
RUN microdnf install -y --setopt=install_weak_deps=0 \
        curl make findutils tar gzip procps-ng bubblewrap \
        yq ShellCheck \
    && microdnf clean all

# Git over HTTPS gets its credentials from gh, which reads GH_TOKEN. This is
# what `gh auth setup-git` writes, set here so no login step is necessary.
RUN git config --system credential.https://github.com.helper '' \
    && git config --system --add credential.https://github.com.helper '!/usr/bin/gh auth git-credential'

# The daemon settings, at the path the base image's default command reads.
COPY --chown=mini-amaru:mini-amaru amaru.yaml project.yaml /config/

USER mini-amaru
RUN make --version | head -n 1 \
    && yq --version \
    && shellcheck --version | head -n 2 \
    && git --version && gh --version | head -n 1 \
    && node --version && npm --version \
    && /app/bin/amaru --version

# The web interface listens on this port (web.listen in amaru.yaml).
EXPOSE 8765
