# The coding bot for wanaku-ai/wanaku: orp-bot picks issues labelled
# `needs-implementation`, works on them with Codex (Claude Code and IBM Bob can be installed too), runs the same Rust
# (with wasm components) and UI checks as Wanaku CI, pushes to its fork
# orp-bot/wanaku and opens pull requests. It never merges.
#
# Build from the root of this repository:
#   make build BOT=wanaku
# or pull quay.io/orpiske/amaru-light-wanaku:latest.
# Run with GH_TOKEN already set in the shell:
#   podman run -d --name amaru-light-wanaku -e GH_TOKEN -p 127.0.0.1:8766:8765 \
#     -v amaru-light-wanaku:/home/mini-amaru:U quay.io/orpiske/amaru-light-wanaku:latest
# Then, on the web interface's Agents page, install Codex (and any other
# agent CLI you want) and sign it in. The image does not ship the CLIs; they
# go to ~/.local on the home volume.

ARG BASE_IMAGE=ghcr.io/amaru-oss/amaru-light:latest

FROM docker.io/library/node:22-trixie-slim AS node
FROM ${BASE_IMAGE}

# Match the Rust and cargo-component versions in Wanaku CI.
ARG RUST_TOOLCHAIN=1.96
ARG CARGO_COMPONENT_VERSION=0.21.1
ARG YARN_VERSION=1.22.22

USER root
RUN microdnf install -y --setopt=install_weak_deps=0 \
        bubblewrap cmake curl diffutils findutils gcc gcc-c++ gzip make \
        openssl-devel pkgconf-pkg-config procps-ng tar xz \
    && microdnf clean all

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && npm install -g --no-audit --no-fund "yarn@${YARN_VERSION}" \
    && npm cache clean --force

RUN git config --system credential.https://github.com.helper '' \
    && git config --system --add credential.https://github.com.helper '!/usr/bin/gh auth git-credential'

ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH
RUN install -d -o mini-amaru -g mini-amaru /opt/rustup /opt/cargo

COPY --chown=mini-amaru:mini-amaru amaru.yaml project.yaml agent-instructions.md /config/

USER mini-amaru
RUN curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal \
        --default-toolchain "${RUST_TOOLCHAIN}" --component clippy,rustfmt --target wasm32-wasip1 \
    && rm /tmp/rustup-init.sh \
    && cargo install cargo-component --version "${CARGO_COMPONENT_VERSION}" --locked

# Limit debug data and concurrent linking for the Podman VM.
ENV CARGO_PROFILE_DEV_DEBUG=0 \
    CARGO_PROFILE_TEST_DEBUG=0 \
    CARGO_BUILD_JOBS=2

RUN /app/bin/amaru --version && git --version && gh --version && ripwire --version \
    && rustup --version && rustc --version && cargo --version && cargo clippy --version \
    && cargo fmt --version && cargo component --version && rustup target list --installed \
    && node --version && npm --version && yarn --version \
    && bwrap --version && gcc --version && g++ --version && cmake --version \
    && make --version && pkg-config --modversion openssl

# The web interface listens on this port (web.listen in amaru.yaml).
EXPOSE 8765
