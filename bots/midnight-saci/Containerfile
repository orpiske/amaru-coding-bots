# The coding bot for orpiske/midnight-saci: orp-bot picks issues labelled
# `needs-implementation`, works on them with Codex (Claude Code and IBM Bob
# can be installed too), runs the same docs, Rust and web console checks as Midnight Saci CI,
# pushes to its fork orp-bot/midnight-saci and opens pull requests. It never
# merges.
#
# The toolchain: Rust (the channel in rust-toolchain.toml) with clippy and
# rustfmt, Node.js 22 (as CI) and the C/C++ tools that the native crates
# (aws-lc-sys, ring, zstd-sys, bundled SQLite) compile with, and kache as
# the Rust build cache.
#
# Build from the root of this repository:
#   make build BOT=midnight-saci
# or pull quay.io/orpiske/amaru-light-midnight-saci:latest.
# Run with GH_TOKEN already set in the shell:
#   podman run -d --name amaru-light-midnight-saci -e GH_TOKEN -p 127.0.0.1:8767:8765 \
#     -v amaru-light-midnight-saci:/home/mini-amaru:U quay.io/orpiske/amaru-light-midnight-saci:latest
# Then, on the web interface's Agents page, install Codex (and any other
# agent CLI you want) and sign it in. The image does not ship the CLIs; they
# go to ~/.local on the home volume.
#
# The browser tests (`npm run e2e`) and the worker image and Kubernetes
# checks (`make image-check`) do not run here: the image has no browser and
# no container runtime.

ARG BASE_IMAGE=ghcr.io/amaru-oss/amaru-light:latest

FROM docker.io/library/node:22-trixie-slim AS node
FROM ${BASE_IMAGE}

# Keep this value the same as the channel in rust-toolchain.toml.
ARG RUST_TOOLCHAIN=1.97.1

USER root
RUN microdnf install -y --setopt=install_weak_deps=0 \
        bash bubblewrap cmake curl diffutils findutils gawk gcc gcc-c++ gzip make \
        procps-ng tar xz \
    && microdnf clean all

# Node.js 22, the version CI uses.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Git over HTTPS gets its credentials from gh, which reads GH_TOKEN. This is
# what `gh auth setup-git` writes, set here so no login step is necessary.
RUN git config --system credential.https://github.com.helper '' \
    && git config --system --add credential.https://github.com.helper '!/usr/bin/gh auth git-credential'

# Rust outside the home volume. The runtime user owns it, so that cargo can
# write its registry cache and rustup can add a toolchain when
# rust-toolchain.toml changes.
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/opt/kache/bin:$PATH
RUN install -d -o mini-amaru -g mini-amaru /opt/rustup /opt/cargo

# kache, the build cache for Rust (and C/C++): cargo runs every rustc through
# it (RUSTC_WRAPPER, set below), so worktrees and tickets reuse each other's
# compiled crates. Its store and daemon live in ~/.cache/kache on the home
# volume, so the cache outlives a new image; the first compile starts the
# daemon. Release binaries per architecture, checked against the release's
# .sha256 files. `kache stats` shows the hit rate.
ARG KACHE_VERSION=2.4.0
ARG KACHE_SHA256_X86_64=6dc5feb2fdcc982538869bc0d0f63ad0da2c8f1a2c22649e7707ff4eb4dbaab7
ARG KACHE_SHA256_AARCH64=061e02232ba1b5f64a0bb3b8e1cdb97cd2dff12932a1522666e32671f8182aae
RUN arch="$(uname -m)" \
    && case "${arch}" in \
        x86_64) sum="${KACHE_SHA256_X86_64}" ;; \
        aarch64) sum="${KACHE_SHA256_AARCH64}" ;; \
        *) echo "no kache release for ${arch}" >&2; exit 1 ;; \
    esac \
    && tarball="kache-${arch}-unknown-linux-musl.tar.gz" \
    && curl -fsSL -o "/tmp/${tarball}" \
        "https://github.com/kunobi-ninja/kache/releases/download/v${KACHE_VERSION}/${tarball}" \
    && echo "${sum}  /tmp/${tarball}" | sha256sum -c - \
    && install -d -o mini-amaru -g mini-amaru /opt/kache /opt/kache/bin \
    && tar -xzf "/tmp/${tarball}" -C /opt/kache/bin --no-same-owner kache kache-engine \
    && chown mini-amaru:mini-amaru /opt/kache/bin/kache /opt/kache/bin/kache-engine \
    && rm "/tmp/${tarball}"

# The daemon settings, at the path the base image's default command reads.
COPY --chown=mini-amaru:mini-amaru amaru.yaml project.yaml agent-instructions.md /config/

USER mini-amaru
RUN curl -fsSL https://sh.rustup.rs -o /tmp/rustup-init.sh \
    && sh /tmp/rustup-init.sh -y --no-modify-path --profile minimal \
        --default-toolchain "${RUST_TOOLCHAIN}" --component clippy,rustfmt \
    && rm /tmp/rustup-init.sh

# Set only now, so the image build itself neither fills a cache nor leaves
# one in the image's home directory.
ENV RUSTC_WRAPPER=/opt/kache/bin/kache

RUN /app/bin/amaru --version && kache --version && git --version && gh --version \
    && rustup --version && rustc --version && cargo --version && cargo clippy --version \
    && cargo fmt --version && node --version && npm --version \
    && bwrap --version && gcc --version && g++ --version && cmake --version && make --version

# The web interface listens on this port (web.listen in amaru.yaml).
EXPOSE 8765
